# Maintainer's Copilot local development environment
# Copy this file to .env and fill only local/dev values.
# Do not commit .env.

# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=maintainers-copilot
ENVIRONMENT=local
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Service ports
# -----------------------------------------------------------------------------
API_PORT=8000
MODEL_SERVER_PORT=8001
CHATBOT_PORT=8501
WIDGET_PORT=3000
HOST_PORT=8080

POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200

# -----------------------------------------------------------------------------
# Vault bootstrap
# Runtime secrets are stored in Vault, not in this file.
# For local Vault dev mode only. Fill in your local token in .env.
# -----------------------------------------------------------------------------
VAULT_ADDR=http://localhost:${VAULT_PORT}
VAULT_DEV_ROOT_TOKEN_ID=

# -----------------------------------------------------------------------------
# Non-secret local service addresses
# These are safe defaults for docker-compose networking.
# Passwords/keys must be loaded from Vault later.
# -----------------------------------------------------------------------------
DATABASE_HOST=db
DATABASE_NAME=maintainers_copilot
DATABASE_USER=maintainers_copilot
DATABASE_URL=postgresql+asyncpg://maintainers_copilot@db:5432/maintainers_copilot
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MODEL_SERVER_URL=http://model-server:8001

# -----------------------------------------------------------------------------
# Tracing
# Langfuse keys must be stored in Vault later.
# This URL is non-secret and may point to hosted or self-hosted Langfuse later.
# -----------------------------------------------------------------------------
LANGFUSE_HOST=http://langfuse-placeholder.local
TRACING_ENABLED=true

# -----------------------------------------------------------------------------
# External provider names only
# API keys must be stored in Vault later.
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic
CHATBOT_MODEL=claude-haiku-4-5
RAG_JUDGE_MODEL=claude-sonnet-4-6
FINE_TUNE_BASE_MODEL=distilbert-base-uncased
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# -----------------------------------------------------------------------------
# Eval thresholds
# Real thresholds will be committed in eval_thresholds.yaml later.
# Do not disable eval gates by setting thresholds to zero.
# -----------------------------------------------------------------------------
EVALS_ENABLED=true
